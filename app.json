{
    "name": "CertiTest",
    "description": "Aplicação de exames de certificação feita com Laravel e Filament.",
    "keywords": [
        "laravel",
        "filament",
        "php"
    ],
    "repository": "https://github.com/felipefejao/certitest",
    "website": "https://github.com/felipefejao/certitest",
    "success_url": "/",
    "env": {
        "APP_NAME": {
            "value": "CertiTest"
        },
        "APP_ENV": {
            "value": "production"
        },
        "APP_DEBUG": {
            "value": "false"
        },
        "APP_KEY": {
            "description": "Chave de criptografia do Laravel (formato base64:...). Gere com `php artisan key:generate --show`. Obrigatória — sem ela, cada dyno usa uma chave efémera diferente e links assinados/sessões falham entre dynos.",
            "required": true
        },
        "DB_CONNECTION": {
            "value": "pgsql"
        },
        "DB_SSLMODE": {
            "value": "require"
        },
        "LOG_CHANNEL": {
            "value": "stderr"
        },
        "SESSION_DRIVER": {
            "value": "database"
        },
        "CACHE_STORE": {
            "value": "database"
        },
        "QUEUE_CONNECTION": {
            "value": "database"
        },
        "MAIL_MAILER": {
            "value": "smtp"
        },
        "MAIL_SCHEME": {
            "value": "smtp"
        },
        "MAIL_HOST": {
            "value": "smtp.gmail.com"
        },
        "MAIL_PORT": {
            "value": "587"
        },
        "MAIL_USERNAME": {
            "description": "Conta Google Workspace usada para envio de e-mail (ex.: noreply@seudominio.com).",
            "required": true
        },
        "MAIL_PASSWORD": {
            "description": "App password da conta Google (16 caracteres, gerada em myaccount.google.com/apppasswords).",
            "required": true
        },
        "MAIL_FROM_ADDRESS": {
            "description": "Endereço remetente. Deve ser igual ao MAIL_USERNAME ou um alias 'Send mail as' verificado no Gmail.",
            "required": true
        }
    },
    "formation": {
        "web": {
            "quantity": 1,
            "size": "basic"
        },
        "worker": {
            "quantity": 1,
            "size": "basic"
        }
    },
    "addons": [
        {
            "plan": "heroku-postgresql:essential-0"
        }
    ],
    "buildpacks": [
        {
            "url": "heroku/nodejs"
        },
        {
            "url": "heroku/php"
        }
    ],
    "scripts": {
        "postdeploy": "php artisan db:seed --force"
    }
}
